# Supabase (required for login, signup, and profile sync)
# Create a project at https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local dev only: set to true to skip the blocking email 2FA prompt after login.
VITE_DISABLE_2FA_GATE=false
